# PostgreSQL connection string (Supabase / Neon / Render Postgres / local)
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Long random string used to sign JWTs — generate with: openssl rand -hex 32
# Never reuse the demo/example value below in a real deployment
JWT_SECRET=replace_with_a_long_random_string

# Port the API listens on
PORT=4000

# Exact origin of the deployed frontend, used to scope CORS
FRONTEND_URL=http://localhost:5173
